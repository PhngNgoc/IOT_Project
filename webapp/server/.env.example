ESP32_HOST=192.168.1.50
ESP32_PORT=80
PORT=3000

# DB file path (default: ./data.sqlite)
# DB_FILE=./data.sqlite

# Retention for readings + events in ms (default 7 days)
# RETENTION_MS=604800000

# Set DEMO=1 to generate fake sensor readings every 5s
# Useful for previewing the dashboard without hardware
# DEMO=1
